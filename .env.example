# Copy to .env and fill in (or set these in your host's dashboard).
PORT=3000
# Public URL of the site, used for Stripe redirects
BASE_URL=http://localhost:3000
# Long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# SMTP settings for password recovery emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Stripe (https://dashboard.stripe.com/apikeys). Leave empty to disable payments.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint pointing at {BASE_URL}/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Set to 1 to fake payments when Stripe is not configured (development only)
DEMO_PAYMENTS=
# Where the database and uploaded photos live. Mount a persistent disk here.
DATA_DIR=./data
# Platform fee in percent, charged to both the customer (on top) and the provider (deducted). Default 10.
PLATFORM_FEE_PERCENT=10
# Waste Warrior Plus subscription: the Stripe price ID of the monthly plan, and the lower customer fee it gives
STRIPE_PLUS_PRICE_ID=
PLUS_FEE_PERCENT=6
PLUS_PRICE_PENCE=295
# Hauler Pro subscription: the Stripe price ID of the monthly plan, and the lower hauler fee it gives
STRIPE_PRO_PRICE_ID=
PRO_FEE_PERCENT=6
PRO_PRICE_PENCE=499
# Emails of admin accounts (comma-separated). They get an Admin page to see all jobs, members and earnings.
ADMIN_EMAILS=
